{
  "opencollection": "1.0.0",
  "info": {
    "name": "Feldera Input Connectors Platform API",
    "version": "0.323.0"
  },
  "items": [
    {
      "info": {
        "name": "Platform",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Auth Config",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/config/authentication"
          },
          "docs": "Retrieve the authentication provider configuration."
        },
        {
          "info": {
            "name": "List API Keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v0/api_keys",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve a list of your API keys."
        },
        {
          "info": {
            "name": "Create API Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v0/api_keys",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new API key with the specified name. The generated API key\nwill be returned in the response and cannot be retrieved again later."
        },
        {
          "info": {
            "name": "Get API Key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v0/api_keys/:api_key_name",
            "params": [
              {
                "name": "api_key_name",
                "value": "",
                "type": "path",
                "description": "Unique API key name"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve the metadata of a specific API key by its name."
        },
        {
          "info": {
            "name": "Delete API Key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v0/api_keys/:api_key_name",
            "params": [
              {
                "name": "api_key_name",
                "value": "",
                "type": "path",
                "description": "Unique API key name"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Remove an API key by its name."
        },
        {
          "info": {
            "name": "List Cluster Events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v0/cluster/events",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve a list of retained cluster monitor events ordered from most recent to least recent.\n\nThe returned events only have limited details, the full details can be retrieved using\nthe `GET /v0/cluster/events/<event-id>` endpoint.\n\nCluster monitor events are collected at a periodic interval (every 10s), however only\nevery 10 minutes or if the overall health changes, does it get inserted into the database\n(and thus, served by this endpoint). At most 1000 events are retained (newest first),\nand ev"
        },
        {
          "info": {
            "name": "Get Cluster Event",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v0/cluster/events/:event_id",
            "params": [
              {
                "name": "event_id",
                "value": "",
                "type": "path",
                "description": "Cluster monitor event identifier or `latest`"
              },
              {
                "name": "selector",
                "value": "",
                "type": "query",
                "description": "The `selector` parameter limits which fields are returned.\nLimiting which fields is particularly handy for instance when frequently\nmonitoring over low bandwidth connections while being only interested\nin status."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get specific cluster monitor event.\n\nThe identifiers of the events can be retrieved via `GET /v0/cluster/events`.\nAt most 1000 events are retained (newest first), and events older than 72h are deleted.\nThe latest event, if it already exists, is never cleaned up.\nThis endpoint can return a 404 for an event that no longer exists due to clean-up."
        },
        {
          "info": {
            "name": "Check Cluster Health",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v0/cluster_healthz",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Determine the latest cluster health via the latest cluster monitor event."
        },
        {
          "info": {
            "name": "Get Platform Config",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v0/config",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve configuration of the Feldera Platform."
        },
        {
          "info": {
            "name": "List Demos",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v0/config/demos",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve the list of demos available in the WebConsole."
        },
        {
          "info": {
            "name": "Get Session",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v0/config/session",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve login session information for your current user session."
        }
      ]
    }
  ],
  "bundled": true
}